@startuml TPO_arquitectura_mvc
' TPO Paradigma Orientado a Objetos - Grupo 3
' Cómo se reparte el código en las tres capas de MVC (paquete ar.edu.uade.poo.grupo3.tpo).
' El detalle de cada clase del modelo está en diagramas/clases/diagrama_clases_entrega2.puml.

skinparam shadowing false
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
hide empty members
top to bottom direction

package "vista  (Swing: arma la pantalla y muestra mensajes)" as vista {
  class BoleteriaApp
  class VentanaPrincipal
  class PanelInicio
  class PanelConsultaSedes
  class PanelAltaSede
  class PanelModificacionSede
  class PanelBajaSede
  class FormularioSector
  class PanelVenta
  class PanelDevolucion
  class PanelRegistroCliente
  class PanelLoginCliente
  class FacturaDialog
  class Estilo
  class Aviso
}

package "controlador  (recibe lo que hace el usuario y se lo pide al modelo)" as controlador {
  class SedeController {
    +listar(filtro): List<Sede>
    +alta(nombre, direccion, sectores): Sede
    +modificarDatos(sede, nombre, direccion)
    +agregarSector(sede, sector)
    +quitarSector(sede, codigo)
    +baja(sede)
  }
  class VentaController {
    -compra: Compra
    -desfaseReloj: Duration
    +reservar(cliente, codigoPreventa, funcion, sector, seleccion, cantidad, conPaqueteVip)
    +aplicarPromocion(codigo): Promocion
    +pagar(medio): Factura
    +cancelar()
    +verificarVencimiento(): boolean
    +segundosRestantes(): long
  }
}

package "modelo  (dominio + persistencia)" as modelo {
  class Boleteria <<singleton>> {
    fachada del modelo
    (Controlador GRASP)
  }
  package infraestructura {
    class Sede
    class Sector
    class Asiento
  }
  package eventos {
    class Evento
    class Funcion
  }
  package ventas {
    class Cliente
    class Compra
    class Entrada
    class Factura
  }
  package reglas {
    interface ReglaDeVenta
  }
  package persistencia {
    interface "Repositorio<T>" as Repositorio
  }
  package promociones {
    class Promocion
  }
  package excepcion {
  }
  package enums {
  }
}

' Vista -> Controlador
BoleteriaApp ..> VentanaPrincipal : crea
VentanaPrincipal ..> SedeController : crea
VentanaPrincipal ..> VentaController : crea
PanelConsultaSedes --> SedeController
PanelAltaSede --> SedeController
PanelModificacionSede --> SedeController
PanelBajaSede --> SedeController
PanelVenta --> VentaController
PanelDevolucion --> VentaController
PanelRegistroCliente --> Boleteria
PanelLoginCliente --> Boleteria
PanelInicio ..> Boleteria : solo lee (estadísticas)

' Controlador -> Modelo
SedeController --> Boleteria
VentaController --> Boleteria

' Modelo
Boleteria --> infraestructura
Boleteria --> eventos
Boleteria --> ventas
Boleteria --> reglas : valida con
Boleteria --> promociones
Boleteria --> persistencia : guarda y carga

@enduml
