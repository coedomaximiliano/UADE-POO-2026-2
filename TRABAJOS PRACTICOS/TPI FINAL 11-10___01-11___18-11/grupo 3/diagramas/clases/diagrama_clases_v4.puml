@startuml TPO_diagrama_clases_v4
' TPO Paradigma Orientado a Objetos - Grupo 3
' Sistema de venta de entradas para sedes de espectáculos
' Diagrama de clases v4 (alineado con el código de la Entrega 2)
' Cambios v3: se quitan Estacionamiento, ExperienciaInmersiva, PrecioDinamico, PoliticaPrecio,
'             Adicional y TipoCargo. Se agregan reserva de 5 minutos, Pago, Devolucion,
'             EstadoCompra, MedioPago y dos excepciones nuevas.
' Cambios v4: registro e inicio de sesión, Factura, Promocion por código, fábrica de sectores,
'             TipoSector y paquete de persistencia (Repository).
' Entrega 2: se quitan Recital, Artista, Cuenta, Pago, Cargo, SectorFactory, FacturaArchivo y
'            AutenticacionException (33 -> 25 clases). Su lógica pasa a Evento, Cliente, Compra,
'            Sector.crear y Factura.guardar.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
hide empty members
top to bottom direction

' ================== INFRAESTRUCTURA ==================
package "Infraestructura" {
  class Sede {
    -nombre: String
    -direccion: String
    -sectores: List<Sector>
    «constructor»+Sede(String nombre, String direccion)
    +agregarSector(Sector s): void
    +buscarSector(String codigo): Sector
    +getCapacidadTotal(): int
  }

  abstract class Sector {
    #codigo: String
    #nombre: String
    #piso: int
    #distanciaEscenario: double
    «constructor»+Sector(String codigo, String nombre, int piso, double distanciaEscenario)
    +calcularMultiplicador(): double
    +{abstract} getCapacidad(): int
    +{abstract} getTipo(): TipoSector
    +{static} crear(TipoSector t, String codigo, String nombre, int piso, double distancia, int filas, int asientosPorFila, int capacidad): Sector
    +{static} crearNumerado(String codigo, String nombre, int piso, double distancia, int filas, int asientosPorFila): SectorNumerado
  }

  enum TipoSector {
    NUMERADO
    GENERAL
  }

  class SectorNumerado {
    -asientos: List<Asiento>
    «constructor»+SectorNumerado(String codigo, String nombre, int piso, double distanciaEscenario)
    +agregarAsiento(Asiento a): void
    +generarAsientos(int filas, int asientosPorFila): void
    +buscarAsiento(String fila, int numero): Asiento
    +getCapacidad(): int
  }

  class SectorGeneral {
    -capacidad: int
    «constructor»+SectorGeneral(String codigo, String nombre, int piso, double distanciaEscenario, int capacidad)
    +getCapacidad(): int
  }

  class Asiento {
    -fila: String
    -numero: int
    «constructor»+Asiento(String fila, int numero)
    +esAdyacente(Asiento otro): boolean
  }
}

' ================== EVENTOS ==================
package "Eventos" {
  class Evento {
    -id: int
    -nombre: String
    -descripcion: String
    -duracionMinutos: int
    -genero: String
    -artistas: List<String>
    -funciones: List<Funcion>
    «constructor»+Evento(int id, String nombre, String descripcion, int duracionMinutos, String genero)
    +agregarArtista(String nombre): void
    +agregarFuncion(Funcion f): void
    +getFuncionesDisponibles(): List<Funcion>
  }

  class Funcion {
    -id: int
    -fechaHora: LocalDateTime
    -precioBase: double
    -estado: EstadoFuncion
    -preventa: Preventa
    -entradas: List<Entrada>
    «constructor»+Funcion(int id, LocalDateTime fechaHora, double precioBase, Sede sede)
    +estaDisponible(Asiento a): boolean
    +getAsientosLibres(Sector s): List<Asiento>
    +lugaresLibres(Sector s): int
    +estaEnPreventa(LocalDateTime ahora): boolean
    +registrarEntrada(Entrada e): void
    +cancelar(): void
  }

  class Preventa {
    -codigoAcceso: String
    -fechaInicio: LocalDateTime
    -fechaFin: LocalDateTime
    «constructor»+Preventa(String codigoAcceso, LocalDateTime fechaInicio, LocalDateTime fechaFin)
    +estaVigente(LocalDateTime ahora): boolean
    +validarCodigo(String codigo): boolean
  }

  enum EstadoFuncion {
    PROGRAMADA
    AGOTADA
    CANCELADA
    FINALIZADA
  }
}

' ================== VENTAS ==================
package "Ventas" {
  class Cliente {
    -dni: String
    -nombre: String
    -email: String
    -hashContrasenia: String
    -compras: List<Compra>
    «constructor»+Cliente(String dni, String nombre, String email, String contrasenia)
    +{static} desdeArchivo(String dni, String nombre, String email, String hash): Cliente
    +verificarContrasenia(String contrasenia): boolean
    +cambiarContrasenia(String contrasenia): void
    +agregarCompra(Compra c): void
  }

  class Promocion {
    -codigo: String
    -porcentaje: double
    -descripcion: String
    «constructor»+Promocion(String codigo, double porcentaje, String descripcion)
    +coincideCon(String codigo): boolean
    +aplicaA(Compra c): boolean
    +calcularDescuento(Compra c): double
  }

  class Factura {
    -numero: String
    -fecha: LocalDateTime
    «constructor»+Factura(Compra c, LocalDateTime fecha)
    +generarTexto(): String
    +guardar(Path carpeta): Path
    +getTotal(): double
  }

  class Compra {
    +{static} MINUTOS_RESERVA: int = 5
    +{static} CARGO_SERVICIO: double = 12
    -nroCompra: int
    -fechaCreacion: LocalDateTime
    -vencimientoReserva: LocalDateTime
    -estado: EstadoCompra
    -codigoPreventa: String
    -entradas: List<Entrada>
    -paquetes: List<PaqueteVIP>
    -promocion: Promocion
    -medioPago: MedioPago
    -nroOperacion: String
    «constructor»+Compra(Cliente cliente, String codigoPreventa, LocalDateTime ahora)
    +agregarEntrada(Funcion f, Sector s, Asiento a): Entrada
    +agregarPaquete(PaqueteVIP p): void
    +aplicarPromocion(Promocion p): void
    +calcularSubtotal(): double
    +calcularDescuento(): double
    +calcularCargos(): double
    +calcularTotal(): double
    +estaVencida(LocalDateTime ahora): boolean
    +confirmar(MedioPago medio, String nroOperacion, LocalDateTime ahora): void
    +vencer(): void
    +cancelar(): void
  }

  class Entrada {
    -codigo: String
    -precio: double
    -valorPagado: double
    -estado: EstadoEntrada
    «constructor»+Entrada(String codigo, Funcion f, Sector s, Asiento a)
    +calcularPrecio(): double
    +pagar(double valorPagado): void
    +anular(): void
    +puedeDevolverse(LocalDateTime ahora): boolean
    +devolver(): void
  }


  class PaqueteVIP {
    -nombre: String
    -beneficios: List<String>
    -precio: double
    -cupo: int
    «constructor»+PaqueteVIP(String nombre, double precio, int cupo)
    +agregarBeneficio(String b): void
    +hayCupo(): boolean
  }


  class Devolucion {
    +{static} HORAS_LIMITE: int = 48
    -fecha: LocalDateTime
    -motivo: String
    -montoReintegro: double
    «constructor»+Devolucion(Entrada e, String motivo)
    +calcularReintegro(): double
  }

  enum EstadoCompra {
    RESERVADA
    CONFIRMADA
    VENCIDA
    CANCELADA
  }

  enum EstadoEntrada {
    RESERVADA
    PAGADA
    ANULADA
    DEVUELTA
  }

  enum MedioPago {
    TARJETA_CREDITO
    TARJETA_DEBITO
    TRANSFERENCIA
    EFECTIVO
  }

  class Boleteria <<controller>> {
    -sedes: List<Sede>
    -eventos: List<Evento>
    -clientes: List<Cliente>
    -compras: List<Compra>
    -devoluciones: List<Devolucion>
    -facturas: List<Factura>
    -promociones: List<Promocion>
    -reglas: List<ReglaDeVenta>
    +{static} getInstancia(): Boleteria
    +registrarCuenta(String dni, String nombre, String email, String contrasenia): Cliente
    +iniciarSesion(String email, String contrasenia): Optional<Cliente>
    +agregarSede(Sede s): void
    +modificarSede(Sede s, String nombre, String direccion): void
    +eliminarSede(Sede s): void
    +buscarFunciones(String nombreEvento): List<Funcion>
    +consultarDisponibilidad(Funcion f, Sector s): List<Asiento>
    +iniciarCompra(Cliente c, String codigoPreventa): Compra
    +reservarAsientos(Compra c, Funcion f, SectorNumerado s, List<Asiento> seleccion, LocalDateTime ahora): void
    +reservarAsientos(Compra c, Funcion f, SectorGeneral s, int cantidad, LocalDateTime ahora): void
    +aplicarCodigoPromocional(Compra c, String codigo): void
    +agregarPaquete(Compra c, PaqueteVIP p): void
    +confirmarCompra(Compra c, MedioPago medio, LocalDateTime ahora): Factura
    +liberarReservasVencidas(LocalDateTime ahora): void
    +devolverEntrada(String codigoEntrada, String motivo): Devolucion
  }
}

' ================== REGLAS Y EXCEPCIONES ==================
package "Reglas" {
  interface ReglaDeVenta {
    +validar(Compra c, Funcion f, Sector s, List<Asiento> seleccion, LocalDateTime ahora): void
  }

  class NoDejarAsientoSuelto {
    +validar(Compra c, Funcion f, Sector s, List<Asiento> seleccion, LocalDateTime ahora): void
  }

  class RequiereCodigoPreventa {
    +validar(Compra c, Funcion f, Sector s, List<Asiento> seleccion, LocalDateTime ahora): void
  }

  class SeleccionInvalidaException <<exception>> {
    «constructor»+SeleccionInvalidaException(String mensaje)
  }

  class ReservaVencidaException <<exception>> {
    «constructor»+ReservaVencidaException(String mensaje)
  }

  class DevolucionNoPermitidaException <<exception>> {
    «constructor»+DevolucionNoPermitidaException(String mensaje)
  }
}

' ================== PERSISTENCIA ==================
package "Persistencia" {
  interface "Repositorio<T>" as Repositorio {
    +cargarTodos(): List<T>
    +guardarTodos(List<T> elementos): void
  }
  class SedeRepositorioArchivo
  class ClienteRepositorioArchivo
}

' ================== RELACIONES ==================
' Herencia / realización
Sector <|-- SectorNumerado
Sector <|-- SectorGeneral
ReglaDeVenta <|.. NoDejarAsientoSuelto
ReglaDeVenta <|.. RequiereCodigoPreventa

' Composición
Sede "1" *-- "1..*" Sector : tiene
SectorNumerado "1" *-- "1..*" Asiento : tiene
Evento "1" *-- "1..*" Funcion : se programa en
Funcion "1" *-- "0..1" Preventa : tiene
Compra "1" *-- "1..*" Entrada : incluye

' Agregación
Compra "*" o-- "*" PaqueteVIP : suma

' Asociaciones
Funcion "*" --> "1" Sede : se realiza en
Funcion "1" --> "*" Entrada : emitidas
Entrada "*" --> "1" Sector : ubicada en
Entrada "*" --> "0..1" Asiento : (solo numerado)
Devolucion "0..1" --> "1" Entrada : devuelve
Cliente "1" -- "*" Compra : realiza
Funcion --> EstadoFuncion
Compra --> EstadoCompra
Entrada --> EstadoEntrada
Compra --> MedioPago

Boleteria --> "*" Sede
Boleteria --> "*" Evento
Boleteria --> "*" Cliente
Boleteria --> "*" Compra
Boleteria --> "*" Devolucion
Boleteria --> "*" ReglaDeVenta : valida con

Repositorio <|.. SedeRepositorioArchivo
Repositorio <|.. ClienteRepositorioArchivo
Compra "*" --> "0..1" Promocion : aplica
Factura "0..1" --> "1" Compra : factura
Sector --> TipoSector
SedeRepositorioArchivo ..> Sector : crea con Sector.crear
Boleteria --> "*" Factura
Boleteria --> "*" Promocion
Boleteria --> SedeRepositorioArchivo
Boleteria --> ClienteRepositorioArchivo

' Dependencias (excepciones)
ReglaDeVenta ..> SeleccionInvalidaException : lanza
Compra ..> ReservaVencidaException : lanza
Boleteria ..> DevolucionNoPermitidaException : lanza

@enduml
