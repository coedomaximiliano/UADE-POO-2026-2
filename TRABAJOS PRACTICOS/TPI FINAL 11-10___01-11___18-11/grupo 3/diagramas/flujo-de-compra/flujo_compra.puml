' TPO Paradigma Orientado a Objetos - Grupo 3
' Flujo de compra end-to-end, devolución y estados
' Cada bloque @startuml genera su propia imagen.

@startuml TPO_secuencia_compra
title Flujo de compra (de punta a punta)
skinparam shadowing false
autonumber

actor "Operador de boletería" as Op
boundary "VentanaVenta\n(Swing)" as UI
control Boleteria
participant "f: Funcion" as F
participant "r: ReglaDeVenta" as R
participant "c: Compra" as C
participant "e: Entrada" as E
participant "cli: Cliente" as Cli

== 1. Buscar función y ver disponibilidad ==
Op -> UI : busca un recital por nombre
UI -> Boleteria : buscarFunciones(nombre)
Boleteria --> UI : List<Funcion>
Op -> UI : elige función y sector
UI -> Boleteria : consultarDisponibilidad(f, sector)
Boleteria -> Boleteria : liberarReservasVencidas(ahora)
Boleteria -> F : getAsientosLibres(sector)
F --> Boleteria : List<Asiento>
Boleteria --> UI : asientos libres (mapa)

== 2. Reservar asientos (5 minutos) ==
Op -> UI : elige cliente, asientos y código de preventa (si hay)
UI -> Boleteria : iniciarCompra(cli, codigoPreventa)
create C
Boleteria -> C : new Compra(nro, cli, codigo)\nvencimiento = ahora + 5'
UI -> Boleteria : reservarAsientos(c, f, sector, seleccion)
loop por cada regla de venta
  Boleteria -> R : validar(c, f, seleccion)
end
alt la selección no cumple una regla
  R --> Boleteria : throw SeleccionInvalidaException
  Boleteria --> UI : excepción
  UI --> Op : diálogo de error\n(ej. "No puede quedar un asiento suelto")
else selección válida
  loop por cada asiento elegido
    Boleteria -> C : agregarEntrada(f, sector, asiento)
    create E
    C -> E : new Entrada(...)\nestado = RESERVADA
    C -> F : registrarEntrada(e)
  end
  Boleteria --> UI : ok
  UI --> Op : muestra cuenta regresiva 05:00
end

== 3. Adicionales y resumen ==
opt el cliente quiere un paquete VIP
  Op -> UI : elige paquete
  UI -> Boleteria : agregarPaquete(c, paquete)
end
UI -> C : calcularTotal()
C --> UI : subtotal + cargos = total
UI --> Op : resumen de la compra

== 4. Pagar y confirmar ==
Op -> UI : elige medio de pago y confirma
UI -> Boleteria : confirmarCompra(c, medio)
alt pasaron más de 5 minutos (c.estaVencida(ahora))
  Boleteria -> C : vencer()
  C -> E : anular()\nel asiento vuelve a quedar libre
  Boleteria --> UI : throw ReservaVencidaException
  UI --> Op : diálogo "La reserva venció, volvé a elegir los asientos"
else reserva vigente
  Boleteria -> C : confirmar(medio, nroOperacion, ahora)
  C -> E : pagar(valorPagado)\nestado = PAGADA
  Boleteria -> Cli : agregarCompra(c)
  Boleteria --> UI : factura
  UI --> Op : diálogo de confirmación con los códigos de entrada
end
@enduml

@startuml TPO_secuencia_devolucion
title Devolución de una entrada
skinparam shadowing false
autonumber

actor "Operador de boletería" as Op
boundary "VentanaDevolucion\n(Swing)" as UI
control Boleteria
participant "e: Entrada" as E
participant "d: Devolucion" as D

Op -> UI : ingresa código de entrada y motivo
UI -> Boleteria : devolverEntrada(codigo, motivo)
Boleteria -> Boleteria : buscar entrada por código
Boleteria -> E : puedeDevolverse(ahora)
note right of E
  true si está PAGADA y
  (faltan 48 hs o más para la función
   o la función fue cancelada)
end note
alt no se puede devolver
  Boleteria --> UI : throw DevolucionNoPermitidaException
  UI --> Op : diálogo con el motivo
else se puede devolver
  create D
  Boleteria -> D : new Devolucion(e, motivo)
  D -> D : calcularReintegro()\n(precio de la entrada, sin cargos)
  Boleteria -> E : devolver()
  note right of E : estado = DEVUELTA\nel asiento vuelve a estar a la venta
  Boleteria --> UI : d
  UI --> Op : diálogo con el monto a reintegrar
end
@enduml

@startuml TPO_estados
title Estados de la Compra y de la Entrada
skinparam shadowing false

state "Compra" as Compra {
  [*] --> RESERVADA : reservarAsientos()\n(vence en 5')
  RESERVADA --> CONFIRMADA : confirmarCompra()\n[antes de los 5']
  RESERVADA --> VENCIDA : pasan 5' sin pagar
  RESERVADA --> CANCELADA : el cliente desiste
  CONFIRMADA --> [*]
  VENCIDA --> [*]
  CANCELADA --> [*]
}

state "Entrada" as Entrada {
  state "RESERVADA" as ER
  state "PAGADA" as EP
  state "ANULADA" as EA
  state "DEVUELTA" as ED
  [*] --> ER : agregarEntrada()
  ER --> EP : la compra se confirma
  ER --> EA : la compra vence o se cancela
  EP --> ED : devolverEntrada()\n[48 hs antes o función cancelada]
  EA --> [*]
  ED --> [*]
  EP --> [*]
}
@enduml
