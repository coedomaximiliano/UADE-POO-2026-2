idSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="1  Guardar turno&#10;PanelCargarTurno obtiene paciente, médico, fecha y hora." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="20" width="1070" height="135" /></mxCell><mxCell id="3" value="2  Validar&#10;GestorTurnos busca los registros y valida la reserva." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="225" width="1070" height="135" /></mxCell><mxCell id="4" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="575" y="155" /><mxPoint as="targetPoint" x="575" y="225" /></mxGeometry></mxCell><mxCell id="5" value="3  Comprobar disponibilidad&#10;RepositorioTurnos revisa médico y paciente." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="430" width="1070" height="135" /></mxCell><mxCell id="6" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="575" y="360" /><mxPoint as="targetPoint" x="575" y="430" /></mxGeometry></mxCell><mxCell id="7" value="4  Registrar&#10;Se crea Turno PENDIENTE y se guarda en memoria." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="635" width="1070" height="135" /></mxCell><mxCell id="8" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="575" y="565" /><mxPoint as="targetPoint" x="575" y="635" /></mxGeometry></mxCell><mxCell id="9" value="5  Preparar recordatorio&#10;NotificadorEmail arma el mensaje simulado." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="840" width="1070" height="135" /></mxCell><mxCell id="10" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="575" y="770" /><mxPoint as="targetPoint" x="575" y="840" /></mxGeometry></mxCell><mxCell id="11" value="6  Informar&#10;La pantalla muestra confirmación y aviso de prueba." style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=23;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1045" width="1070" height="135" /></mxCell><mxCell id="12" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="575" y="975" /><mxPoint as="targetPoint" x="575" y="1045" /></mxGeometry></mxCell><mxCell id="13" value="Si fallan las validaciones no se crea el turno" style="text;html=0;align=center;verticalAlign=middle;whiteSpace=wrap;fillColor=#ffffff;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=0;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="1240" width="1070" height="40" /></mxCell></root></mxGraphModel></diagram><diagram name="Estados del turno"><mxGraphModel dx="1400" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="620" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="PENDIENTE" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=28;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="360" y="50" width="380" height="110" /></mxCell><mxCell id="3" value="ATENDIDO" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=28;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="360" width="400" height="110" /></mxCell><mxCell id="4" value="CANCELADO" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=0;align=center;verticalAlign=middle;fontSize=28;fontFamily=Arial;fillColor=#ffffff;strokeColor=#222222;strokeWidth=2;" vertex="1" parent="1"><mxGeometry as="geometry" x="660" y="360" width="400" height="110" /></mxCell><mxCell id="5" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><mxGeometry as="geometry" relative="1"><mxPoint as="sourcePoint" x="440" y="160" /><mxPoint as="targetPoint" x="240" y="360" /><Array as="points"><mxPoint x="440" y="250" /><mxPoint x="240" y="250" /></Array></mxGeometry></mxCell><mxCell id="6" style="edgeStyle=none;rounded=0;html=0;strokeColor=#222222;strokeWidth=2;endArrow=open;endFill=0;endSize=18;dashed=0;" edge="1" parent="1"><m